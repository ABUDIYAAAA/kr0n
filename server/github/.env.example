# Server Configuration
PORT=8082
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# Database & Redis Configuration
DB_CONN=postgres://postgres:postgres@localhost:5432/kron_github?sslmode=disable
REDIS_CONN=redis://localhost:6379/2

# JWT Authentication Secrets (matching auth microservice)
JWT_ACCESS_SECRET=access-secret-32-chars-key-12345
COOKIE_NAME_ACCESS=kron_access
COOKIE_ACCESS_SIGNATURE=cookie-signature-secret-12345

# GitHub App Integration Configuration
GITHUB_APP_ID=123456
GITHUB_APP_CLIENT_ID=Iv1.xyz12345
GITHUB_APP_CLIENT_SECRET=github_app_client_secret_here
GITHUB_APP_PRIVATE_KEY_PATH=./keys/github-app.private-key.pem
GITHUB_WEBHOOK_SECRET=github_webhook_secret_here
