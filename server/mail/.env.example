# ==========================================
# Kr0n Mail Microservice Environment Configuration
# ==========================================

# Service Metadata
SERVICE_NAME=mail-service

# Database & Cache Connection Strings
DB_URL=postgres://postgres:postgres@localhost:5432/kron_mail?sslmode=disable
REDIS_URI=redis://localhost:6379/0

# Kafka Broker & Topic Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=mail-service-group
KAFKA_EMAIL_TOPIC=email-events

# Worker Pool & Concurrency Control
MAIL_WORKER_POOL_SIZE=10
MAIL_QUEUE_CAPACITY=100

# Default SMTP Account Configuration
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@kron.com
SMTP_FROM_NAME="Kr0n Team"
