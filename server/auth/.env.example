# ==========================================
# Kr0n Auth Service Environment Configuration
# ==========================================

# Server Settings
PORT=8080
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DB_URL=postgres://postgres:password@localhost:5432/kr0n_auth?sslmode=disable

# Redis Cache / Session Blacklist Configuration
REDIS_URI=redis://localhost:6379/0

# JWT Secrets & Expirations
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Cookie Settings & Tamper-Proof Signing
COOKIE_DOMAIN=
COOKIE_NAME_ACCESS=kr0n_access_token
COOKIE_NAME_REFRESH=kr0n_refresh_token
COOKIE_NAME_DEVICEID=kr0n_device_id
COOKIE_ACCESS_SIGNATURE=your_tamper_proof_hmac_sha256_cookie_signing_key_32_chars

# OAuth 2.0 Providers: Google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CLIENT_CALLBACK=http://localhost:8080/api/v1/auth/oauth/google/callback

# OAuth 2.0 Providers: GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CLIENT_CALLBACK=http://localhost:8080/api/v1/auth/oauth/github/callback

